<main class="contenedor">
    <section class="tarjeta" style="border-top: 10px solid {{pregunta.categoria_color}};">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="etiqueta">{{pregunta.categoria_nombre}}</span>
            <span class="etiqueta" style="color: #333;">Puntos: {{puntajeTotal}}</span>
        </div>

        <h1 style="margin-top: 20px;">{{pregunta.enunciado}}</h1>

        <form id="form-respuesta" action="/partida/responder" method="POST"
              style="display: flex; flex-direction: column; gap: 10px; margin-top: 20px;">
            {{#pregunta.opciones}}
                <button type="submit" name="opcion_id" value="{{id}}" class="boton boton-secundario"
                        style="text-align: left; padding: 15px;">
                    {{texto}}
                </button>
            {{/pregunta.opciones}}
        </form>
    </section>
</main>

<script>
    // Evita que un doble click envie la respuesta dos veces.
    (function () {
        var form = document.getElementById('form-respuesta');
        var enviado = false;
        form.addEventListener('submit', function (evento) {
            if (enviado) {
                evento.preventDefault();
                return;
            }
            enviado = true;
        });
    })();
</script>
