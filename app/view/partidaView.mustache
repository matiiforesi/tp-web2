<main class="contenedor-juego">
    <section id="tarjeta-juego" class="tarjeta tarjeta-juego" style="--color-categoria: {{pregunta.categoria_color}};">
        <div class="juego-cabecera">
            <span class="etiqueta">{{pregunta.categoria_nombre}}</span>
            {{#jugando}}
                <span id="timer" class="juego-timer" data-segundos="{{segundos}}">{{segundos}}</span>
            {{/jugando}}
            <span class="juego-puntos">Puntos: {{puntajeTotal}}</span>
        </div>

        {{#jugando}}
            <div class="timer-barra">
                <div id="timer-progreso" class="timer-progreso"></div>
            </div>
        {{/jugando}}

        <h1 class="juego-enunciado">{{pregunta.enunciado}}</h1>

        {{#jugando}}
            <form id="form-respuesta" class="juego-opciones" action="/partida/responder" method="POST">
                {{#pregunta.opciones}}
                    <button type="submit" name="opcion_id" value="{{id}}" class="boton boton-secundario opcion">
                        <span class="opcion-texto">{{texto}}</span>
                    </button>
                {{/pregunta.opciones}}
            </form>
        {{/jugando}}

        {{^jugando}}
            <div class="juego-opciones">
                {{#pregunta.opciones}}
                    <div class="boton boton-secundario opcion opcion-resultado {{clase}}">
                        <span class="opcion-texto">{{texto}}</span>
                    </div>
                {{/pregunta.opciones}}
            </div>

            <p class="resultado-mensaje {{claseMensaje}}">{{mensaje}}</p>
            <a id="continuar" href="{{siguiente}}" class="boton juego-continuar"{{#avanzarSolo}} data-avanzar-solo{{/avanzarSolo}}>{{textoSiguiente}}</a>
        {{/jugando}}
    </section>

    <div style="text-align: center; margin-top: 2rem;">
        <button type="button" onclick="document.getElementById('form-reporte').style.display='block'" style="background: none; border: none; color: #888; text-decoration: underline; cursor: pointer;">
            🚩 Reportar un problema con esta pregunta
        </button>

        <div id="form-reporte" style="display: none; margin-top: 1rem; padding: 1.5rem; background: #f8d7da; border-radius: 8px; text-align: left; border: 1px solid #f5c2c7;">
            <form action="/pregunta/reportar" method="POST">
                <input type="hidden" name="pregunta_id" value="{{pregunta.id}}">

                <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #842029;">¿Cuál es el problema con esta pregunta?</label>
                <textarea name="motivo" rows="3" required placeholder="Ej: La respuesta correcta está mal, tiene faltas de ortografía, etc." style="width: 100%; padding: 10px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 4px; resize: vertical;"></textarea>

                <div style="display: flex; gap: 10px;">
                    <button type="submit" class="boton" style="background: #dc3545; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold;">Enviar Reporte</button>
                    <button type="button" onclick="document.getElementById('form-reporte').style.display='none'" style="background: none; border: none; text-decoration: underline; cursor: pointer; color: #842029;">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</main>

<script>
    (function () {
        var form = document.getElementById('form-respuesta');
        var continuar = document.getElementById('continuar');

        if (continuar && continuar.hasAttribute('data-avanzar-solo')) {
            setTimeout(function () {
                window.location.href = continuar.href;
            }, 2500);
        }

        if (!form) {
            return;
        }

        var tarjeta = document.getElementById('tarjeta-juego');
        var timer = document.getElementById('timer');
        var progreso = document.getElementById('timer-progreso');
        var totalMs = parseInt(timer.dataset.segundos, 10) * 1000;
        var limite = Date.now() + totalMs;
        var enviado = false;

        // Evita que un doble click envie la respuesta dos veces.
        form.addEventListener('submit', function (evento) {
            if (enviado) {
                evento.preventDefault();
                return;
            }
            enviado = true;
            form.classList.add('enviado');
        });

        function actualizar() {
            if (enviado) {
                return;
            }

            var restante = Math.max(0, limite - Date.now());
            var segundos = Math.ceil(restante / 1000);

            timer.textContent = segundos;
            progreso.style.transform = 'scaleX(' + (restante / totalMs) + ')';
            tarjeta.classList.toggle('tiempo-urgente', segundos <= 5);

            if (restante === 0) {
                enviado = true;
                form.classList.add('enviado');
                form.submit();
                return;
            }

            requestAnimationFrame(actualizar);
        }

        actualizar();
    })();
</script>
