<main class="contenedor-juego">
    <section id="tarjeta-juego" class="tarjeta tarjeta-juego" style="--color-categoria: {{pregunta.categoria_color}};">
        <div class="juego-cabecera">
            <span class="etiqueta">{{pregunta.categoria_nombre}}</span>
            {{#jugando}}
                <span id="timer" class="juego-timer" data-segundos="{{segundos}}"
                      data-total="{{segundosTotales}}">{{segundos}}</span>
            {{/jugando}}
            <div class="juego-vidas-bloque">
                <span class="juego-vidas">♥ {{vidas}} vidas</span>
                {{#proximaVidaSegundos}}<span class="juego-proxima-vida">+1 vida en <strong class="cuenta-regresiva-vida"
                                                                                            data-segundos="{{proximaVidaSegundos}}"></strong></span>{{/proximaVidaSegundos}}
            </div>
        </div>

        {{#jugando}}
            <div class="timer-barra">
                <div id="timer-progreso" class="timer-progreso"></div>
            </div>
        {{/jugando}}

        <h1 class="juego-enunciado">{{pregunta.enunciado}}</h1>

        {{#jugando}}
            <form id="form-respuesta" class="juego-opciones" action="/partida/responder" method="POST">
                {{#pregunta.opciones}}
                    <button type="submit" name="opcion_id" value="{{id}}"
                            class="boton boton-secundario opcion{{#eliminada}} opcion-eliminada{{/eliminada}}"{{#eliminada}}
                            disabled{{/eliminada}}>
                        <span class="opcion-texto">{{texto}}</span>
                    </button>
                {{/pregunta.opciones}}
            </form>
        {{/jugando}}

        {{#jugando}}
            <nav class="estrategias-dock" aria-label="Estrategias canjeables">
                <div class="dock-saldo"><i class="icono-moneda" aria-hidden="true">$</i> <strong
                        id="saldo-monedas">{{dinero}}</strong></div>
                <div class="dock-opciones">
                    <button type="button" class="dock-item{{#usadaBomba}} dock-usado{{/usadaBomba}}"
                            data-estrategia="bomba"{{#usadaBomba}}
                            disabled{{/usadaBomba}} title="Bomba: elimina dos respuestas incorrectas, 20 monedas"><span
                            class="dock-icono" aria-hidden="true">💣</span><span class="dock-nombre">Bomba</span><span
                            class="dock-precio">20 <i class="icono-moneda dock-moneda" aria-hidden="true">$</i></span>
                    </button>
                    <button type="button" class="dock-item" data-estrategia="saltear"
                            title="Saltear pregunta sin perder vida, 80 monedas"><span class="dock-icono"
                                                                                       aria-hidden="true">⏭️</span><span
                            class="dock-nombre">Saltear</span><span class="dock-precio">80 <i
                            class="icono-moneda dock-moneda" aria-hidden="true">$</i></span></button>
                    <button type="button" class="dock-item{{#usadaEscudo}} dock-usado{{/usadaEscudo}}"
                            data-estrategia="escudo"{{#usadaEscudo}}
                            disabled{{/usadaEscudo}} title="Protege una vida ante un error, 60 monedas"><span
                            class="dock-icono" aria-hidden="true">🛡️</span><span class="dock-nombre">Escudo</span><span
                            class="dock-precio">60 <i class="icono-moneda dock-moneda" aria-hidden="true">$</i></span>
                    </button>
                    <button type="button" class="dock-item{{#usadaTiempo}} dock-usado{{/usadaTiempo}}"
                            data-estrategia="tiempo"{{#usadaTiempo}}
                            disabled{{/usadaTiempo}} title="Agrega 15 segundos, 25 monedas"><span class="dock-icono"
                                                                                                  aria-hidden="true">⏱️</span><span
                            class="dock-nombre">+15 seg</span><span class="dock-precio">25 <i
                            class="icono-moneda dock-moneda" aria-hidden="true">$</i></span></button>
                </div>
            </nav>
            <p id="mensaje-estrategia" class="mensaje-estrategia" role="status" aria-live="polite"></p>
        {{/jugando}}

        {{^jugando}}
            <div class="juego-opciones">
                {{#pregunta.opciones}}
                    <div class="boton boton-secundario opcion opcion-resultado {{clase}}">
                        <span class="opcion-texto">{{texto}}</span>
                    </div>
                {{/pregunta.opciones}}
            </div>

            <p class="resultado-mensaje {{claseMensaje}}">{{mensaje}}</p>
            <div class="resultado-datos">
                <div class="resultado-puntajes">
                    <div><strong>{{puntosPartida}}</strong><span>Partida</span></div>
                    <div><strong>{{puntajeHoy}}</strong><span>Hoy</span></div>
                    <div><strong>{{puntajeTotal}}</strong><span>Total</span></div>
                </div>
                {{#bonificacion}}<p class="racha-bonus">Racha de {{racha}}: +{{bonificacion}} monedas</p>{{/bonificacion}}
            </div>
            {{#avisoReporte}}<p class="info" role="status">{{avisoReporte}}</p>{{/avisoReporte}}
            {{#sinVidas}}<p class="mensaje resultado-mal">Te quedaste sin vidas.</p>{{/sinVidas}}
            {{#falloYContinua}}
                <div class="fin-acciones">
                    <a href="/partida/jugar" class="boton">Volver a jugar</a>
                    <a href="/usuario/lobby" class="boton boton-secundario">Volver al inicio</a>
                </div>
            {{/falloYContinua}}
            {{#sinVidas}}
                <div class="fin-acciones">
                    <a href="/usuario/lobby" class="boton">Volver al inicio</a>
                    <a href="/ranking/ver" class="boton boton-secundario">Ver ranking</a>
                </div>
            {{/sinVidas}}
            {{^falloYContinua}}{{^sinVidas}}
                <a id="continuar" href="{{siguiente}}" class="boton juego-continuar">{{textoSiguiente}}</a>
            {{/sinVidas}}{{/falloYContinua}}
        {{/jugando}}
    </section>

    {{^jugando}}
        <div class="reporte">
            <button type="button" class="reporte-abrir" onclick="document.getElementById('form-reporte').style.display='block'">
                🚩 Reportar un problema con esta pregunta
            </button>

            <div id="form-reporte" class="reporte-form" style="display: none;">
                <form action="/pregunta/reportar" method="POST">
                    <input type="hidden" name="pregunta_id" value="{{pregunta.id}}">

                    <label class="reporte-label" for="reporte-motivo">¿Cuál es el
                        problema con esta pregunta?</label>
                    <textarea name="motivo" id="reporte-motivo" class="reporte-motivo" rows="3" required
                              placeholder="Ej: La respuesta correcta está mal, tiene faltas de ortografía, etc."></textarea>

                    <div class="reporte-acciones">
                        <button type="submit" class="boton">
                            Enviar Reporte
                        </button>
                        <button type="button" class="reporte-cancelar" onclick="document.getElementById('form-reporte').style.display='none'">
                            Cancelar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    {{/jugando}}
</main>

<script>
    (function () {
        var form = document.getElementById('form-respuesta');

        if (!form) {
            return;
        }

        var tarjeta = document.getElementById('tarjeta-juego');
        var timer = document.getElementById('timer');
        var progreso = document.getElementById('timer-progreso');
        // data-segundos es lo que queda (el servidor lo calcula, también al recargar); data-total es el tiempo completo de la pregunta.
        var restanteInicial = parseInt(timer.dataset.segundos, 10) * 1000;
        var totalMs = (parseInt(timer.dataset.total, 10) || parseInt(timer.dataset.segundos, 10)) * 1000;
        var limite = Date.now() + restanteInicial;
        var enviado = false;

        // Evita que un doble click envie la respuesta dos veces.
        form.addEventListener('submit', function (evento) {
            if (enviado) {
                evento.preventDefault();
                return;
            }
            enviado = true;
            form.classList.add('enviado');
        });

        var dock = document.querySelector('.estrategias-dock');
        var avisoDock = document.getElementById('mensaje-estrategia');
        if (dock) {
            dock.addEventListener('click', function (evento) {
                var botonEstrategia = evento.target.closest('[data-estrategia]');
                if (!botonEstrategia || botonEstrategia.disabled || enviado) return;
                botonEstrategia.disabled = true;
                avisoDock.textContent = 'Canjeando…';
                fetch('/partida/estrategia', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: 'accion=' + encodeURIComponent(botonEstrategia.dataset.estrategia)
                })
                        .then(function (respuesta) {
                            return respuesta.json().then(function (datos) {
                                if (!respuesta.ok) throw new Error(datos.error || 'No se pudo canjear.');
                                return datos;
                            });
                        })
                        .then(function (datos) {
                            if (datos.redirect) {
                                window.location.href = datos.redirect;
                                return;
                            }
                            if (datos.dinero !== undefined) document.getElementById('saldo-monedas').textContent = datos.dinero;
                            if (datos.eliminar) {
                                datos.eliminar.forEach(function (idOpcion) {
                                    var opcion = form.querySelector('[name="opcion_id"][value="' + idOpcion + '"]');
                                    if (opcion) {
                                        opcion.disabled = true;
                                        opcion.classList.add('opcion-eliminada');
                                    }
                                });
                                avisoDock.textContent = 'La bomba eliminó dos respuestas incorrectas.';
                            } else if (datos.accion === 'tiempo') {
                                totalMs += 15000;
                                limite += 15000;
                                avisoDock.textContent = '¡Tenés 15 segundos extra!';
                            } else if (datos.accion === 'escudo') avisoDock.textContent = 'Escudo activo: protege la próxima respuesta incorrecta.';
                            botonEstrategia.classList.add('dock-usado');
                            botonEstrategia.title = 'Ya usaste esta estrategia en esta pregunta';
                        })
                        .catch(function (error) {
                            avisoDock.textContent = error.message;
                            botonEstrategia.disabled = false;
                        });
            });
        }

        function actualizar() {
            if (enviado) {
                return;
            }

            var restante = Math.max(0, limite - Date.now());
            var segundos = Math.ceil(restante / 1000);

            timer.textContent = segundos;
            progreso.style.transform = 'scaleX(' + (restante / totalMs) + ')';
            tarjeta.classList.toggle('tiempo-urgente', segundos <= 5);

            if (restante === 0) {
                enviado = true;
                form.classList.add('enviado');
                form.submit();
                return;
            }

            requestAnimationFrame(actualizar);
        }

        actualizar();
    })();
</script>
<script src="/public/js/vidas-timer.js" defer></script>
