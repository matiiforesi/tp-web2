<main class="contenedor" style="max-width: 600px;">
    <h2 style="color: #243b53; margin-bottom: 1rem;">Sugerir Pregunta</h2>

    {{#aviso}}
        <div class="errores" role="alert">{{aviso}}</div>
    {{/aviso}}

    <div class="tarjeta">
        <form action="/pregunta/guardar" method="POST">
            <div style="margin-bottom: 1rem;">
                <label>Categoría:</label>
                <select name="categoria_id" required style="width: 100%; padding: 10px; margin-top: 5px;">
                    <option value="">Seleccioná una categoría</option>
                    {{#categorias}}
                        <option value="{{id}}">{{nombre}}</option>
                    {{/categorias}}
                </select>
            </div>

            <div style="margin-bottom: 1rem;">
                <label>Pregunta:</label>
                <input type="text" name="enunciado" required style="width: 100%; padding: 10px; margin-top: 5px;">
            </div>

            <div style="margin-bottom: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
                <p>Opciones (marcá la correcta):</p>

                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <input type="radio" name="correcta" value="1" required>
                    <input type="text" name="opcion1" placeholder="Opción 1" required style="width: 100%; padding: 5px;">
                </div>
                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <input type="radio" name="correcta" value="2">
                    <input type="text" name="opcion2" placeholder="Opción 2" required style="width: 100%; padding: 5px;">
                </div>
                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <input type="radio" name="correcta" value="3">
                    <input type="text" name="opcion3" placeholder="Opción 3" required style="width: 100%; padding: 5px;">
                </div>
                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <input type="radio" name="correcta" value="4">
                    <input type="text" name="opcion4" placeholder="Opción 4" required style="width: 100%; padding: 5px;">
                </div>
            </div>

            <button type="submit" class="boton boton-primario" style="width: 100%;">Enviar Sugerencia</button>
            <div style="text-align: center; margin-top: 1rem;">
                <a href="/usuario/lobby" style="color: #666;">Cancelar</a>
            </div>
        </form>
    </div>
</main>