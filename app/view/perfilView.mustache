<main class="contenedor">
    <section class="tarjeta perfil">
        <span class="etiqueta">Mi cuenta</span>
        <h1>Mi perfil</h1>

        <div class="perfil-encabezado">
            {{#perfil.tieneFoto}}
                <img class="perfil-foto" src="/usuario/foto" alt="Foto de perfil de {{perfil.usuario}}">
            {{/perfil.tieneFoto}}
            {{^perfil.tieneFoto}}
                <div class="perfil-foto perfil-foto-vacia" aria-hidden="true">👤</div>
            {{/perfil.tieneFoto}}
            <div>
                <h2>{{perfil.usuario}}</h2>
                <p class="nota">{{perfil.estadoCuenta}}</p>
            </div>
        </div>

        <h2 class="perfil-seccion">Tu progreso en el juego</h2>
        <div class="estadisticas-juego">
            <div><strong>{{perfil.puntaje_total}}</strong><span>Puntos</span></div>
            <div><strong>{{perfil.estadisticas.partidas}}</strong><span>Partidas jugadas</span></div>
            <div><strong>{{perfil.estadisticas.porcentaje}}%</strong><span>Precisión</span></div>
        </div>

        <div class="perfil-datos">
            <div><span>Nombre completo</span><strong>{{perfil.nombre_completo}}</strong></div>
            <div><span>Email</span><strong>{{perfil.email}}</strong></div>
            <div><span>Fecha de nacimiento</span><strong>{{perfil.fecha_nacimiento}}</strong></div>
            <div><span>Sexo</span><strong>{{perfil.sexo}}</strong></div>
            <div><span>Ubicación</span><strong>{{perfil.ciudad}}, {{perfil.pais}}</strong></div>
            <div><span>Miembro desde</span><strong>{{perfil.fecha_registro}}</strong></div>
        </div>

        <div class="acciones">
            <button type="button" class="boton" id="abrir-qr">Ver QR público</button>
            <a href="/usuario/lobby" class="boton boton-secundario">Volver al lobby</a>
        </div>
    </section>
</main>
<div class="modal-qr" id="modal-qr" hidden role="dialog" aria-modal="true" aria-labelledby="titulo-qr">
    <div class="modal-qr-contenido">
        <button type="button" class="modal-qr-cerrar" id="cerrar-qr" aria-label="Cerrar">×</button>
        <h2 id="titulo-qr">Compartí tu perfil</h2>
        <div id="qr-imagen" class="qr-imagen" aria-label="Código QR de tu perfil"></div>
        <p class="nota">Escaneá el código para abrir tu perfil público.</p>
    </div>
</div>
<script src="/public/js/qrcode.min.js" defer></script>
<script src="/public/js/perfil-qr.js" defer></script>
<script>window.perfilPublicoUrl = window.location.origin + '/usuario/publico?usuario={{perfil.usuario}}';</script>
