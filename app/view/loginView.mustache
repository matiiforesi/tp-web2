<main class="contenedor">
    <section class="tarjeta">
        <span class="etiqueta">Acceso</span>
        <h1>Iniciar sesión</h1>

        {{#info}}
            <div class="info" role="status">
                {{info}}
            </div>
        {{/info}}

        {{#error}}
            <div class="errores" role="alert">
                {{error}}
                {{#cuentaPendiente}}
                    <div>
                        En caso de no encontrarlo, podes
                        <form action="/usuario/reenviar" method="POST" style="display: inline;">
                            <input type="hidden" name="usuario" value="{{usuario}}">
                            <button class="reenvio" type="submit">reenviar el correo de activación.</button>
                        </form>
                    </div>
                {{/cuentaPendiente}}
            </div>
        {{/error}}

        <form id="form-login" class="formulario" action="/usuario/autenticar" method="POST" novalidate>
            <div class="campo">
                <label for="usuario">Nombre de usuario</label>
                <input type="text" id="usuario" name="usuario" value="{{usuario}}" minlength="3" maxlength="20"
                       autocomplete="username" required autofocus>
            </div>

            <div class="campo">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" minlength="8" maxlength="72"
                       autocomplete="current-password" required>
            </div>

            <div class="acciones">
                <button type="submit" class="boton">Iniciar sesión</button>
            </div>
        </form>

        <p class="nota">¿Todavía no tenés una cuenta? <a href="/usuario/registro">Registrate acá</a>.</p>
    </section>
</main>
