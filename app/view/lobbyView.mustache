<main class="contenedor">
    {{#aviso}}
        <div class="errores" role="alert">{{aviso}}</div>
    {{/aviso}}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h2 style="margin: 0; color: #243b53;">¡Hola, {{usuario}}!</h2>
        </div>
        <a href="/usuario/perfil" class="boton boton-secundario">Mi Perfil</a>
    </div>

    <div style="display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;">

        <section class="tarjeta"
                 style="flex: 2; min-width: 300px; text-align: center; background: linear-gradient(135deg, #243b53 0%, #356a9a 100%); color: white; border: none;">
            <span class="etiqueta" style="color: #a5c3e3;">Tu Progreso</span>
            <h1 style="color: white; font-size: 3rem; margin: 0.5rem 0;">{{puntajeTotal}} PTS</h1>
            <p style="color: #dbe4ef; margin-bottom: 2rem;">Puntaje acumulado total</p>

            <a href="/partida/nueva" class="boton"
               style="background: #fff; color: #243b53; font-size: 1.2rem; padding: 1rem 2rem;">▶ Jugar Nueva
                Partida</a>
        </section>

        <section class="tarjeta"
                 style="flex: 1; min-width: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
            <h2 style="font-size: 3rem; margin: 0;">🏆</h2>
            <h3>Ranking Global</h3>
            <p class="nota" style="margin-bottom: 1.5rem;">Mirá quién lidera la tabla</p>
            <a href="/ranking/ver" class="boton boton-secundario" style="width: 100%;">Ver Ranking</a>
        </section>

    </div>

    <details class="sugerir-pregunta">
        <summary class="boton boton-secundario sugerir-boton">💡 Sugerir una pregunta</summary>

        <div class="tarjeta sugerir-contenido">
        <p class="nota">Un editor la revisa antes de que aparezca en el juego.</p>

        <form class="formulario" action="/pregunta/guardar" method="POST">
            <div class="campo">
                <label for="sugerir-categoria">Categoría</label>
                <select id="sugerir-categoria" name="categoria_id" required>
                    <option value="" selected disabled>Elegí una categoría</option>
                    <option value="1">Historia</option>
                    <option value="2">Deportes</option>
                    <option value="3">Cultura</option>
                    <option value="4">Ciencia</option>
                    <option value="5">Geografía</option>
                    <option value="6">Entretenimiento</option>
                </select>
            </div>

            <div class="campo">
                <label for="sugerir-enunciado">Pregunta</label>
                <textarea id="sugerir-enunciado" name="enunciado" rows="2" maxlength="500"
                          placeholder="Ej: ¿Cuál es la capital de Italia?" required></textarea>
            </div>

            <fieldset class="campo sugerir-opciones">
                <legend>Respuestas <small>(marcá la correcta)</small></legend>
                <label class="sugerir-opcion">
                    <input type="radio" name="correcta" value="1" required>
                    <input type="text" name="opcion1" maxlength="255" placeholder="Respuesta A" required>
                </label>
                <label class="sugerir-opcion">
                    <input type="radio" name="correcta" value="2">
                    <input type="text" name="opcion2" maxlength="255" placeholder="Respuesta B" required>
                </label>
                <label class="sugerir-opcion">
                    <input type="radio" name="correcta" value="3">
                    <input type="text" name="opcion3" maxlength="255" placeholder="Respuesta C" required>
                </label>
                <label class="sugerir-opcion">
                    <input type="radio" name="correcta" value="4">
                    <input type="text" name="opcion4" maxlength="255" placeholder="Respuesta D" required>
                </label>
            </fieldset>

            <button type="submit" class="boton">Enviar pregunta</button>
        </form>
        </div>
    </details>

    <div class="tarjeta" style="margin-top: 2rem;">
        <h3 style="border-bottom: 1px solid #dbe3ed; padding-bottom: 0.5rem; text-align: center;">Tus últimas
            partidas</h3>

        {{#hayPartidas}}
            <div class="tabla-scroll">
                <table class="tabla">
                    <thead>
                    <tr>
                        <th>Fecha</th>
                        <th class="col-puntaje">Resultado</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#partidas}}
                        <tr>
                            <td>{{fecha}}</td>
                            <td class="col-puntaje"><strong>{{puntos}}</strong> {{etiquetaPuntos}}</td>
                        </tr>
                    {{/partidas}}
                    </tbody>
                </table>
            </div>
        {{/hayPartidas}}
        {{^hayPartidas}}
            <p class="nota" style="margin-top: 1rem; text-align: center;">Todavía no jugaste ninguna partida. ¡Hacé clic
                en Jugar para empezar!</p>
        {{/hayPartidas}}
    </div>

</main>
