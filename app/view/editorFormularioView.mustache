<main class="contenedor editor-dashboard">
    <div class="editor-bienvenida">
        <span class="etiqueta">GESTIÓN DE PREGUNTAS</span>
        <h1>{{titulo}}</h1>
        <p>Completá entre 2 y 4 opciones y marcá cuál es la correcta.</p>
    </div>

    {{#hayErrores}}
        <div class="errores" role="alert">
            <strong>Revisá estos datos:</strong>
            <ul>{{#errores}}<li>{{mensaje}}</li>{{/errores}}</ul>
        </div>
    {{/hayErrores}}

    <form class="tarjeta editor-item editor-formulario" action="/pregunta/guardarEditor" method="POST">
        <input type="hidden" name="id" value="{{id}}">
        <input type="hidden" name="volver" value="{{volver}}">

        <label class="editor-label" for="enunciado">Enunciado</label>
        <textarea id="enunciado" name="enunciado" maxlength="500" required>{{enunciado}}</textarea>

        <div class="editor-formulario-fila">
            <div>
                <label class="editor-label" for="categoria">Categoría</label>
                <select id="categoria" name="categoria_id" required>
                    <option value="">Elegí una categoría</option>
                    {{#categorias}}<option value="{{id}}"{{#seleccionada}} selected{{/seleccionada}}>{{nombre}}</option>{{/categorias}}
                </select>
            </div>
            <div>
                <label class="editor-label" for="estado">Estado</label>
                <select id="estado" name="estado">
                    {{#estados}}<option value="{{valor}}"{{#seleccionado}} selected{{/seleccionado}}>{{etiqueta}}</option>{{/estados}}
                </select>
            </div>
        </div>

        <fieldset class="editor-opciones">
            <legend class="editor-label">Opciones (marcá la correcta)</legend>
            {{#opciones}}
                <div class="editor-opcion">
                    <input type="hidden" name="opcion_id{{numero}}" value="{{id}}">
                    <label class="editor-opcion-correcta" title="Marcar como correcta">
                        <input type="radio" name="correcta" value="{{numero}}"{{#esCorrecta}} checked{{/esCorrecta}} required>
                        <span>{{letra}}</span>
                    </label>
                    <input type="text" name="opcion{{numero}}" value="{{texto}}" maxlength="255"
                           placeholder="Opción {{letra}}{{^obligatoria}} (opcional){{/obligatoria}}"{{#obligatoria}} required{{/obligatoria}}
                           aria-label="Opción {{letra}}">
                    {{#usada}}<small class="editor-opcion-nota">Ya la eligieron jugadores: se puede editar pero no borrar.</small>{{/usada}}
                </div>
            {{/opciones}}
        </fieldset>

        <div class="editor-acciones">
            <button type="submit" class="boton">{{#esNueva}}Crear pregunta{{/esNueva}}{{^esNueva}}Guardar cambios{{/esNueva}}</button>
            <a href="{{volver}}" class="boton boton-secundario">Cancelar</a>
        </div>
    </form>
</main>
