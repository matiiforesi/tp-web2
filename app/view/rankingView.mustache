<main class="contenedor">
    <section class="tarjeta">
        <span class="etiqueta">Ranking</span>
        <h1>🏆 Mejores jugadores</h1>
        <nav class="ranking-periodos" aria-label="Período del ranking">
            {{#periodos}}
                <a href="/ranking/ver?periodo={{clave}}" class="ranking-periodo{{#activo}}
                ranking-periodo-activo{{/activo}}"{{#activo}} aria-current="true"{{/activo}}>{{etiqueta}}</a>
            {{/periodos}}
        </nav>
        <p class="mensaje">{{#esTotal}}
            Puntaje acumulado de todas las partidas.{{/esTotal}}{{^esTotal}}
            Puntos ganados en: <strong>{{periodoEtiqueta}}</strong>.{{/esTotal}}</p>

        {{#hayJugadores}}
            <div class="tabla-scroll">
                <table class="tabla">
                    <thead>
                    <tr>
                        <th class="col-posicion">#</th>
                        <th>Jugador</th>
                        <th>País</th>
                        <th class="col-puntaje">Puntaje</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#jugadores}}
                        <tr class="{{#esUsuarioActual}}fila-yo{{/esUsuarioActual}}">
                            <td class="col-posicion">{{#medalla}}{{medalla}}{{/medalla}}{{^medalla}}{{posicion}}{{/medalla}}</td>
                            <td><a href="/usuario/publico?usuario={{usuario}}">{{usuario}}</a>{{#esUsuarioActual}}
                                <span class="etiqueta-yo">TÚ</span>{{/esUsuarioActual}}
                            </td>
                            <td>{{pais}}</td>
                            <td class="col-puntaje"><strong>{{puntaje}}</strong></td>
                        </tr>
                    {{/jugadores}}
                    </tbody>
                </table>
            </div>
        {{/hayJugadores}}
        {{^hayJugadores}}
            <p class="nota">Nadie sumó puntos en este período. ¡Sé el primero en jugar!</p>
        {{/hayJugadores}}

        <div class="acciones">
            <a href="/partida/nueva" class="boton">▶ Jugar</a>
            <a href="/usuario/lobby" class="boton boton-secundario">Volver al lobby</a>
        </div>
    </section>
</main>
