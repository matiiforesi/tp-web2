<main class="contenedor-juego">
    <section class="tarjeta tarjeta-juego fin-partida">
        <h1 class="juego-enunciado">Fin de la partida</h1>

        {{^fueCorrecta}}
            <div class="fin-incorrecta">
                <p>La respuesta correcta era:</p>
                <strong>{{respuestaCorrecta}}</strong>
            </div>
        {{/fueCorrecta}}

        <div class="fin-puntos">
            <p>Puntos en esta partida</p>
            <strong>{{puntosGanados}}</strong>
        </div>

        <div class="fin-acciones">
            <a href="/partida/nueva" class="boton">Jugar de nuevo</a>
            <a href="/usuario/lobby" class="boton boton-secundario">Ir al Lobby</a>
        </div>
    </section>
</main>
