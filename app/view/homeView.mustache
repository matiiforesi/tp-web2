<main class="contenedor">

    <section class="tarjeta" style="text-align: center;">
        <span class="etiqueta">Bienvenido</span>
        <h1>{{titulo}}</h1>
        <p class="mensaje">{{subtitulo}}</p>

        {{#estaLogueado}}
            <div style="margin-top: 1.5rem;">
                <h3>¡Hola, {{nombreUsuario}}!</h3>
                <p class="nota">Puntaje actual: 0 pts (Próximamente)</p>

                <div style="display: flex; gap: 10px; justify-content: center; margin-top: 1rem; flex-wrap: wrap;">
                    <a href="/" class="boton">Nueva Partida</a>
                    <a href="/" class="boton boton-secundario">Ver Ranking</a>
                </div>
            </div>
        {{/estaLogueado}}

        {{^estaLogueado}}
            <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem;">
                <a href="/usuario/registro" class="boton">Crear Cuenta</a>
                <a href="/usuario/login" class="boton boton-secundario">Iniciar Sesión</a>
            </div>
        {{/estaLogueado}}
    </section>

    <div style="display: flex; gap: 15px; flex-wrap: wrap; justify-content: center; margin-top: 20px;">
        <div class="tarjeta" style="flex: 1; min-width: 250px; text-align: center;">
            <h2 style="font-size: 2rem;">🎯</h2>
            <h3>Respondé Preguntas</h3>
            <p class="nota">Preguntas de múltiple opción de distintas categorías.</p>
        </div>

        <div class="tarjeta" style="flex: 1; min-width: 250px; text-align: center;">
            <h2 style="font-size: 2rem;">🏆</h2>
            <h3>Sumá Puntos</h3>
            <p class="nota">Cada respuesta correcta suma. Competí por el primer puesto.</p>
        </div>

        <div class="tarjeta" style="flex: 1; min-width: 250px; text-align: center;">
            <h2 style="font-size: 2rem;">📊</h2>
            <h3>Mirá el Ranking</h3>
            <p class="nota">Conocé tu posición en el ranking de jugadores.</p>
        </div>
    </div>

</main>