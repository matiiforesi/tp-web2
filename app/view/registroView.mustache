<main class="contenedor">
    <section class="tarjeta">
        <span class="etiqueta">Crear cuenta</span>
        <h1>Registrate</h1>

        {{#hayErrores}}
        <div class="errores" role="alert">
            <strong>Revisá los siguientes puntos:</strong>
            <ul>
                {{#errores}}<li>{{mensaje}}</li>{{/errores}}
            </ul>
        </div>
        {{/hayErrores}}

        <form id="form-registro" class="formulario" action="/usuario/registrar" method="POST" enctype="multipart/form-data" novalidate>
            <div class="campo">
                <label for="nombre_completo">Nombre completo</label>
                <input type="text" id="nombre_completo" name="nombre_completo" value="{{datos.nombre_completo}}" minlength="3" maxlength="100" autocomplete="name" required>
            </div>

            <div class="fila">
                <div class="campo">
                    <label for="anio_nacimiento">Año de nacimiento</label>
                    <input type="number" id="anio_nacimiento" name="anio_nacimiento" value="{{datos.anio_nacimiento}}" min="{{anioMinimo}}" max="{{anioMaximo}}" inputmode="numeric" required>
                </div>
                <div class="campo">
                    <label for="sexo">Sexo</label>
                    <select id="sexo" name="sexo" required>
                        {{#sexos}}
                        <option value="{{valor}}" {{#selected}}selected{{/selected}}>{{etiqueta}}</option>
                        {{/sexos}}
                    </select>
                </div>
            </div>

            <div class="fila">
                <div class="campo">
                    <label for="pais_id">País</label>
                    <select id="pais_id" name="pais_id" required>
                        <option value="">Elegí un país</option>
                        {{#paises}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{nombre}}</option>
                        {{/paises}}
                    </select>
                </div>
                <div class="campo">
                    <label for="ciudad_id">Ciudad</label>
                    <select id="ciudad_id" name="ciudad_id" required>
                        <option value="">Elegí una ciudad</option>
                        {{#ciudades}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{nombre}}</option>
                        {{/ciudades}}
                    </select>
                </div>
            </div>

            <div class="mapa" id="mapa-contenedor" hidden>
                <iframe id="mapa-iframe" title="Mapa de la ciudad elegida" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                <a id="mapa-enlace" href="#" target="_blank" rel="noopener">Ver mapa más grande</a>
            </div>

            <div class="campo">
                <label for="email">Mail</label>
                <input type="email" id="email" name="email" value="{{datos.email}}" maxlength="100" autocomplete="email" required>
            </div>

            <div class="campo">
                <label for="usuario">Nombre de usuario</label>
                <input type="text" id="usuario" name="usuario" value="{{datos.usuario}}" minlength="3" maxlength="20" pattern="[A-Za-z0-9_]+" autocomplete="username" required>
                <small>De 3 a 20 caracteres: letras, números o guión bajo.</small>
            </div>

            <div class="fila">
                <div class="campo">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required>
                    <small>Mínimo 8 caracteres.</small>
                </div>
                <div class="campo">
                    <label for="password_repetida">Repetir contraseña</label>
                    <input type="password" id="password_repetida" name="password_repetida" minlength="8" maxlength="72" autocomplete="new-password" required>
                </div>
            </div>

            <div class="campo">
                <label for="foto_perfil">Foto de perfil</label>
                <input type="file" id="foto_perfil" name="foto_perfil" accept="image/jpeg,image/png,image/webp" required>
                <small>JPG, PNG o WEBP, hasta 2 MB.</small>
                <img id="foto-preview" class="foto-preview" alt="Vista previa de la foto de perfil" hidden>
            </div>

            <button type="submit" class="boton">Crear cuenta</button>
        </form>
    </section>
</main>

<script type="application/json" id="ciudades-data">{{{ciudadesJson}}}</script>
<script src="/public/js/registro.js" defer></script>
