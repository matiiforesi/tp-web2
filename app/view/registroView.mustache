<main class="contenedor">
    <section class="tarjeta">
        <span class="etiqueta">Crear cuenta</span>
        <h1>Registrate</h1>

        {{#hayErrores}}
            <div class="errores" role="alert">
                <strong>Revisá los siguientes puntos:</strong>
                <ul>
                    {{#errores}}
                        <li>{{mensaje}}</li>{{/errores}}
                </ul>
            </div>
        {{/hayErrores}}

        <form id="form-registro" class="formulario" action="/usuario/registrar" method="POST"
              enctype="multipart/form-data" novalidate>
            <div class="campo">
                <label for="nombre_completo">Nombre completo</label>
                <input type="text" id="nombre_completo" name="nombre_completo" value="{{datos.nombre_completo}}"
                       minlength="3" maxlength="100" autocomplete="name" required>
            </div>

            <div class="fila">
                <div class="campo">
                    <label for="anio_nacimiento">Año de nacimiento</label>
                    <input type="number" id="anio_nacimiento" name="anio_nacimiento" value="{{datos.anio_nacimiento}}"
                           min="{{anioMinimo}}" max="{{anioMaximo}}" inputmode="numeric" required>
                </div>
                <div class="campo">
                    <label for="sexo">Sexo</label>
                    <select id="sexo" name="sexo" required>
                        {{#sexos}}
                            <option value="{{valor}}" {{#selected}}selected{{/selected}}>{{etiqueta}}</option>
                        {{/sexos}}
                    </select>
                </div>
            </div>

            <div class="campo">
                <label for="mapa">Tu ubicación</label>
                <div id="mapa" class="mapa-seleccion" role="application"
                     aria-label="Mapa para elegir tu ubicación"></div>
                <p id="ubicacion-texto" class="ubicacion-texto" aria-live="polite">Hacé click en el mapa para marcar tu
                    ciudad.</p>
                <input type="hidden" id="pais_codigo" name="pais_codigo" value="{{datos.pais_codigo}}">
                <input type="hidden" id="pais" name="pais" value="{{datos.pais}}">
                <input type="hidden" id="ciudad" name="ciudad" value="{{datos.ciudad}}">
                <input type="hidden" id="latitud" name="latitud" value="{{datos.latitud}}">
                <input type="hidden" id="longitud" name="longitud" value="{{datos.longitud}}">
            </div>

            <div class="campo">
                <label for="email">Mail</label>
                <input type="email" id="email" name="email" value="{{datos.email}}" maxlength="100" autocomplete="email"
                       required>
            </div>

            <div class="campo">
                <label for="usuario">Nombre de usuario</label>
                <input type="text" id="usuario" name="usuario" value="{{datos.usuario}}" minlength="3" maxlength="20"
                       pattern="[A-Za-z0-9_]+" autocomplete="username" required>
                <small>De 3 a 20 caracteres: letras, números o guión bajo.</small>
            </div>

            <div class="fila">
                <div class="campo">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" minlength="8" maxlength="72"
                           autocomplete="new-password" required>
                    <small>Mínimo 8 caracteres.</small>
                </div>
                <div class="campo">
                    <label for="password_repetida">Repetir contraseña</label>
                    <input type="password" id="password_repetida" name="password_repetida" minlength="8" maxlength="72"
                           autocomplete="new-password" required>
                </div>
            </div>

            <div class="campo">
                <label for="foto_perfil">Foto de perfil</label>
                <input type="file" id="foto_perfil" name="foto_perfil" accept="image/jpeg,image/png,image/webp"
                       required>
                <small>JPG, PNG o WEBP, hasta 2 MB.</small>
                <img id="foto-preview" class="foto-preview" alt="Vista previa de la foto de perfil" hidden>
            </div>

            <button type="submit" class="boton">Crear cuenta</button>
        </form>
    </section>
</main>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>
<script src="/public/js/registro.js" defer></script>
