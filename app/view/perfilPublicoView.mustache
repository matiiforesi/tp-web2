<main class="contenedor">
    {{#encontrado}}
        <section class="tarjeta perfil perfil-publico">
            <span class="etiqueta">Perfil público</span>
            <div class="perfil-encabezado">
                {{#perfil.tieneFoto}}<img class="perfil-foto" src="/usuario/fotoPublica?usuario={{perfil.usuario}}" alt="Foto de perfil de {{perfil.usuario}}">{{/perfil.tieneFoto}}
                {{^perfil.tieneFoto}}<div class="perfil-foto perfil-foto-vacia" aria-hidden="true">👤</div>{{/perfil.tieneFoto}}
                <div><h1>{{perfil.usuario}}</h1><p class="nota">{{perfil.nombre_completo}}</p></div>
            </div>
            <div class="perfil-datos">
                <div><span>Ubicación</span><strong>{{perfil.ciudad}}, {{perfil.pais}}</strong></div>
                <div><span>Puntaje</span><strong>{{perfil.puntaje_total}} puntos</strong></div>
                <div><span>Partidas jugadas</span><strong>{{perfil.estadisticas.partidas}}</strong></div>
                <div><span>Precisión</span><strong>{{perfil.estadisticas.porcentaje}}%</strong></div>
            </div>
            <div class="acciones"><button type="button" class="boton" id="abrir-qr">Mostrar QR</button></div>
        </section>
    {{/encontrado}}
    {{^encontrado}}
        <section class="tarjeta"><h1>Perfil no encontrado</h1><p class="mensaje">El jugador no existe o todavía no activó su cuenta.</p><a href="/" class="boton">Volver al inicio</a></section>
    {{/encontrado}}
</main>
<div class="modal-qr" id="modal-qr" hidden role="dialog" aria-modal="true" aria-labelledby="titulo-qr">
    <div class="modal-qr-contenido">
        <button type="button" class="modal-qr-cerrar" id="cerrar-qr" aria-label="Cerrar">×</button>
        <h2 id="titulo-qr">Compartí este perfil</h2>
        <img src="/usuario/qr?usuario={{perfil.usuario}}" width="240" height="240" alt="Código QR del perfil de {{perfil.usuario}}">
        <p class="nota">Escaneá el código para abrir este perfil.</p>
    </div>
</div>
<script>(function(){var m=document.getElementById('modal-qr'),a=document.getElementById('abrir-qr'),c=document.getElementById('cerrar-qr');if(!m||!a||!c)return;a.onclick=function(){m.hidden=false};c.onclick=function(){m.hidden=true};m.onclick=function(e){if(e.target===m)m.hidden=true}})();</script>
